PORT=3000
NODE_ENV=development

# ==========================================
# AUTHENTICATION AND SECRETS
# ==========================================
# Generate a unique value locally. Never reuse the example placeholder:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-cryptographically-random-value
JWT_EXPIRY=1d
# Temporário para clientes não-web legados. Mantenha false no frontend web.
LEGACY_BEARER_TOKEN_RESPONSE=false

# Optional, until encryption-at-rest is enabled by the application.
# Generate independently from JWT_SECRET.
# ENCRYPTION_KEY=replace-with-an-independent-random-encryption-key

# ==========================================
# DATABASE (PostgreSQL in every environment)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=replace-with-development-database
DB_USER=replace-with-application-database-user
DB_PASSWORD=replace-with-application-database-password
# Schema migrations must run with a separate owner role.
DB_MIGRATION_USER=replace-with-migration-owner
DB_MIGRATION_PASSWORD=replace-with-migration-owner-password
# Separate NOBYPASSRLS role reserved for audited cross-tenant operations.
DB_GLOBAL_USER=cerne_global
DB_GLOBAL_PASSWORD=replace-with-independent-global-database-password

# Private object storage (bucket must not be public)
OBJECT_STORAGE_DRIVER=supabase
OBJECT_STORAGE_BUCKET=replace-with-private-bucket-name
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_KEY=replace-with-server-side-storage-key

# Durable delivery outbox
OUTBOX_ENCRYPTION_KEY=replace-with-independent-high-entropy-encryption-key
OUTBOX_WORKER_ENABLED=true
FRONTEND_PUBLIC_URL=https://replace-with-frontend-origin.example
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=replace-with-sender-address
DB_POOL_MIN=2
DB_POOL_MAX=10
# Tests must use a separate disposable database.
DB_NAME_TEST=replace-with-disposable-test-database
# DATABASE_URL and DATABASE_URL_TEST may replace the fields above.
# DB_SSL=true

# Administrative maintenance scripts require explicit runtime values.
# All maintenance scripts also require an explicit active tenant slug.
# CERNE_TENANT_SLUG=replace-with-active-tenant-slug
# CERNE_ADMIN_CPF=replace-with-target-identifier
# CERNE_ADMIN_EMAIL=replace-with-target-address
# CERNE_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# CERNE_SUPER_ADMIN_CPF=replace-with-target-identifier
# CERNE_SUPER_ADMIN_EMAIL=replace-with-target-address
# CERNE_SUPER_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# CERNE_SYSTEM_MANAGER_CPF=replace-with-target-identifier
# CERNE_SYSTEM_MANAGER_EMAIL=replace-with-target-address
# CERNE_SYSTEM_MANAGER_PASSWORD=replace-with-a-strong-one-time-password
# CERNE_PROFESSOR_CPF=replace-with-target-identifier
# CERNE_PROFESSOR_EMAIL=replace-with-target-address
# CERNE_PROFESSOR_PASSWORD=replace-with-a-strong-one-time-password
# CERNE_SEED_USERS_JSON=replace-with-a-json-array-provided-at-runtime

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SENSITIVE_OPS=10

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
