PORT=3000
NODE_ENV=development

# ==========================================
# AUTENTICAÇÃO E SEGREDOS
# ==========================================
# IMPORTANTE: JWT_SECRET deve ter MÍNIMO 32 caracteres aleatórios
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA use valores padrão em produção!
JWT_SECRET=your_super_safe_secret_key_min_32_chars_generated_securely
JWT_EXPIRY=1d

# ==========================================
# BANCO DE DADOS (SQLite para dev, PostgreSQL para prod)
# ==========================================
# Desenvolvimento
DATABASE_URL=file:./dev.db

# Produção (descomente e configure)
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=filiacao_db
# DB_USER=postgres
# DB_PASSWORD=your_strong_password_min_12_chars
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ==========================================
# EMAIL SERVICE
# ==========================================
# Desenvolvimento (mock via console)
# Produção: Configure com serviço real (SendGrid, AWS SES, etc)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user_placeholder
SMTP_PASS=ethereal_pass_placeholder
SMTP_FROM=noreply@filiacao.example.com

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ==========================================
# RATE LIMITING
# ==========================================
# Proteção contra abuso de API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SENSITIVE_OPS=10

# ==========================================
# CORS & SEGURANÇA
# ==========================================
# Whitelist de origens permitidas (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

