{
    "name": "backend",
    "version": "1.0.0",
    "description": "Enterprise Member Management System Backend",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "db:migrate": "knex migrate:latest",
        "db:rollback": "knex migrate:rollback",
        "db:cycle": "knex migrate:latest && knex migrate:rollback --all && knex migrate:latest",
        "db:make": "knex migrate:make",
        "test": "cross-env NODE_ENV=test jest",
        "lint": "eslint src tests db/migrations db/seeds"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.117.2",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.22.3",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "joi": "^18.2.9",
        "jsonwebtoken": "^9.0.2",
        "knex": "^3.3.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^10.0.12",
        "pdfkit": "^0.14.0",
        "pg": "^8.23.0",
        "qrcode": "^1.5.4",
        "speakeasy": "^2.0.0",
        "uuid": "^11.1.1",
        "winston": "^3.19.0",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-plugin-security": "^3.0.1",
        "jest": "^30.5.2",
        "nodemon": "^3.0.2",
        "supertest": "^7.3.0"
    }
}
